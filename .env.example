# Example environment file — copy this to `.env` and fill it in:
#
#     cp .env.example .env
#
# `.env` is git-ignored, so real values never reach the repository.
# In CI, these are provided as GitHub Actions Secrets, not from this file.

# --- Credentials (REQUIRED — treated as secrets) ---------------------------
# The suite will NOT run until these are set. Leave them blank here; put the
# real values only in your local `.env` (or in CI secrets). Never commit them.
SAUCE_USERNAME=
SAUCE_PASSWORD=
SAUCE_LOCKED_OUT_USER=
SAUCE_PROBLEM_USER=

# --- Negative-test inputs (optional — intentionally fake, not secrets) ------
# Used by the invalid-login tests; they must NOT match a real account.
SAUCE_INVALID_USER=invalid_user
SAUCE_INVALID_PASSWORD=wrong_password

# --- Run configuration (optional — not secret) -----------------------------
BASE_URL=https://www.saucedemo.com/
BROWSER=chrome
HEADLESS=false
EXPLICIT_WAIT=10
PAGE_LOAD_TIMEOUT=30
