# Example environment file.
#
# Copy this file to `.env` and adjust as needed:
#     cp .env.example .env
#
# `.env` is git-ignored, so real values never reach the repository.
# SauceDemo uses PUBLIC demo credentials, so the suite already runs without
# any of these set - they are here only to document the pattern and to allow
# overriding without editing code. Treat real credentials as secrets.

# --- Credentials -----------------------------------------------------------
SAUCE_USERNAME=standard_user
SAUCE_PASSWORD=secret_sauce
SAUCE_LOCKED_OUT_USER=locked_out_user
SAUCE_PROBLEM_USER=problem_user
SAUCE_INVALID_USER=invalid_user
SAUCE_INVALID_PASSWORD=wrong_password

# --- Run configuration -----------------------------------------------------
BASE_URL=https://www.saucedemo.com/
BROWSER=chrome
HEADLESS=false
EXPLICIT_WAIT=10
PAGE_LOAD_TIMEOUT=30
